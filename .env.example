# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required. Postgres connection string (used from #5 on).
DATABASE_URL=postgresql://routechat:routechat@localhost:5432/routechat

# Optional. dev | test | prod
APP_ENV=dev
# Optional. DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Note: LLM provider API keys are NOT configured here. Users add them in the app (BYOK),
# and they are stored encrypted in the database (#v0.3).
